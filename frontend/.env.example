# Bhoomi Rakshak Frontend Environment Variables
# Copy to .env for local development or add to your Vercel/Netlify Environment Variables

# In production (e.g. Vercel), set this to your deployed FastAPI backend URL:
# Example: VITE_API_URL=https://bhoomi-rakshak-api.onrender.com
# In local development, leave empty or set to:
VITE_API_URL=http://localhost:8000
